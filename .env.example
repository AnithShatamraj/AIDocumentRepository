# ─────────────────────────────────────────────────────────────────────────────
# AI Document Repository — environment configuration
# Copy to `.env` and adjust. Everything has a working local default.
# ─────────────────────────────────────────────────────────────────────────────

# --- Core ---
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database (Postgres + pgvector) ---
# Async URL is used by the API; sync URL by Celery/Alembic.
POSTGRES_USER=aidocs
POSTGRES_PASSWORD=aidocs
POSTGRES_DB=aidocs
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# When running the API/worker inside docker-compose, host is `postgres`.

# --- Redis (Celery broker + pub/sub for SSE) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Inside docker-compose, host is `redis`.

# --- Object storage (cloud-agnostic) ---
# provider: minio | s3 | azure | gcs
STORAGE_PROVIDER=minio
STORAGE_BUCKET=aidocs
# S3 / MinIO
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
# Inside docker-compose, endpoint is http://minio:9000
# Azure Blob (STORAGE_PROVIDER=azure)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=
# GCS (STORAGE_PROVIDER=gcs)
GCS_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# --- AI providers (multi-provider, config-driven) ---
# Global default provider used when a stage doesn't override it.
# provider options: openai | anthropic | azure_openai | stub
AI_DEFAULT_PROVIDER=openai
# If no key is set the app falls back to the deterministic `stub` provider so it
# runs fully offline. Set your real key to use OpenAI.
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=

# LLM model per capability (override per-stage in Admin later)
LLM_MODEL=gpt-4o-mini
LLM_CLASSIFY_MODEL=gpt-4o-mini
LLM_EXTRACT_MODEL=gpt-4o-mini
LLM_SUMMARIZE_MODEL=gpt-4o-mini
LLM_CHAT_MODEL=gpt-4o-mini

# Embeddings
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Use the deepagents agentic framework for ingestion (classify/extract/taxonomy).
# Falls back to a deterministic non-agentic path when false or when no API key.
INGESTION_USE_DEEPAGENTS=true

# --- PDF parsing (IBM Docling as a separate service) ---
# docling = layout + bounding boxes + OCR via docling-serve (compose service `docling`);
# pdfplumber = legacy in-process fallback (no OCR, no bboxes).
PDF_PARSER=docling
DOCLING_URL=http://localhost:5001
# auto = OCR bitmap/scanned content only | force = re-OCR everything | off = native text only
DOCLING_OCR=auto
DOCLING_TIMEOUT_SECONDS=1800

# --- Pipeline / processing config ---
MAX_UPLOAD_MB=50
CHUNK_TOKENS=800
CHUNK_OVERLAP_TOKENS=120
CLASSIFY_CONFIDENCE_THRESHOLD=0.60
EXTRACT_AUTOACCEPT_THRESHOLD=0.85
CHAT_MAX_TOKENS_PER_DAY=200000

# --- Bootstrap (first-run seed) ---
SEED_TENANT_NAME=Acme Corp
SEED_ADMIN_EMAIL=admin@acme.com
SEED_ADMIN_PASSWORD=admin12345
